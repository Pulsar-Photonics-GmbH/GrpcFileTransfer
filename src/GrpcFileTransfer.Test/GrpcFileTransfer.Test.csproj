<!-- MSTest.Sdk (version pinned in global.json) runs the tests on Microsoft.Testing.Platform and
     brings MSTest, its analyzers and the code coverage and TRX report extensions. -->
<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Pulsar.GrpcFileTransfer.Test</RootNamespace>
        <AssemblyName>Pulsar.GrpcFileTransfer.Test</AssemblyName>
        <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GrpcFileTransfer\GrpcFileTransfer.csproj" />
    </ItemGroup>

</Project>
